# Written to web/.env.local by scripts/deploy.mjs. All of these are testnet keys.

# Pays gas and submits what members have already authorised.
TIDEOVER_RELAY_ACCOUNT=
TIDEOVER_RELAY_KEY=

# Creates demo members.
TIDEOVER_JOINER_ACCOUNT=
TIDEOVER_JOINER_KEY=

# Lets a visitor vote for a demo panelist or council member. It can do nothing else.
TIDEOVER_DEMO_KEY=

# The sealed reader. With neither of the next two setups, claims go to people after the
# review window.
#
# In an enclave, which is the private one. This server only ever carries ciphertext.
TIDEOVER_CLERK_WASM_URL=
TIDEOVER_CLERK_WASM_HASH=
#
# On this server, for a fund that has not pinned an enclave build. This server could read
# what it opens, and the Trust page says so. Use invented documents only. The NEAR AI key
# comes from the API Keys page at cloud.near.ai and starts with sk-. A nearbuilders.org key
# is for that site's own API and will not work here.
TIDEOVER_CLERK_SEED=
NEAR_AI_API_KEY=

# The most model reviews this server will ask for in a day. After that, claims go to people.
TIDEOVER_MAX_REVIEWS_PER_DAY=40
