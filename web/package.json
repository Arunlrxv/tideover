{
  "name": "tideover-web",
  "private": true,
  "version": "0.1.0",
  "description": "Tideover: the app for a private hardship fund on a Sputnik DAO",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "deploy:testnet": "node scripts/deploy.mjs",
    "e2e": "node scripts/e2e.mjs",
    "model-check": "node --no-warnings scripts/model-check.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "borsh": "2.0.0",
    "near-api-js": "7.4.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3"
  }
}
